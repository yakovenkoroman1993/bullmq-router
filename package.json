{
  "name": "@yakocloud/bullmq-router",
  "version": "3.0.1",
  "description": "Bullmq router",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yakovenkoroman1993/bullmq-router"
  },
  "homepage": "https://github.com/yakovenkoroman1993/bullmq-router#readme",
  "bugs": {
    "url": "https://github.com/yakovenkoroman1993/bullmq-router/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/main.js",
    "dev": "BULLMQ_ROUTER_NODE_ENV=development tsx ./src/main.ts",
    "type-check": "tsc --project tsconfig.json",
    "test": "BULLMQ_ROUTER_NODE_ENV=development node --import tsx --test --test-force-exit 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bullmq": "^6.7.1",
    "iovalkey": "^0.4.0",
    "redis": "^6.3.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "bullmq": "^6.7.1"
  }
}
